              "id": "qfw4gpk",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<section class=\"hero\">\n  <div class=\"hero-frame\" id=\"hero\">\n    <div class=\"hero-zoom\">\n      <div class=\"hero-drop\">\n        <div class=\"kb\" style=\"background-image:url('/wp-content/themes/natajiwa-child/assets/img/gallery-01.webp')\"></div>\n      </div>\n    </div>\n    <div class=\"hero-copy\">\n      <h1><span class=\"line\"><i>Find Your</i></span><span class=\"line\"><i>Stillness Here</i></span></h1>\n      <a class=\"btn light\" href=\"/contact/\">Book Your Stay</a>\n    </div>\n    <a class=\"scroll-cue\" href=\"#stay\" aria-label=\"Scroll down\"><span>Scroll</span><i></i></a>\n  </div>\n</section>\n\n<!-- INTRO -->\n<section class=\"intro\">\n  <img class=\"emblem reveal\" src=\"/wp-content/themes/natajiwa-child/assets/img/natajiwa-logo-768.webp\" alt=\"\" style=\"filter:none\">\n  <p class=\"reveal d1\">Natajiwa Village is a wooden sanctuary in the heart of Kerobokan — a love letter to slow mornings, garden light, and the quiet luxury of Bali, moments from Canggu and Seminyak.</p>\n</section>\n\n<!-- STAY -->\n<section class=\"wrap split\" id=\"stay\">\n  <div class=\"media\"><img src=\"/wp-content/themes/natajiwa-child/assets/img/gallery-05.webp\" alt=\"Wooden house interior\"></div>\n  <div class=\"body reveal d1\">\n    <span class=\"label\">Rooms</span>\n    <h2>Stay with us</h2>\n    <p>Three ways to rest, each wrapped in teak, garden, and calm. Air-conditioned comfort, private bathrooms, and a bathtub to sink into after a day by the coast.</p>\n    <ul class=\"roomlist\">\n      <li><span>Wooden House · Garden View</span><span class=\"n\">01</span></li>\n      <li><span>Wooden House · Private Pool</span><span class=\"n\">02</span></li>\n      <li><span>Deluxe Studio</span><span class=\"n\">03</span></li>\n    </ul>\n    <a class=\"btn\" href=\"/rooms/\">View All Rooms</a>\n  </div>\n</section>\n\n<!-- BAND -->\n<section class=\"band\" style=\"background-image:url('/wp-content/themes/natajiwa-child/assets/img/gallery-08.webp')\"></section>\n\n<!-- DINING -->\n<section class=\"wrap split rev\" id=\"dining\">\n  <div class=\"media\"><img src=\"/wp-content/themes/natajiwa-child/assets/img/partner-image.webp\" alt=\"Restoran Sorai\"></div>\n  <div class=\"body reveal d1\">\n    <span class=\"label\">Restoran Sorai</span>\n    <h2>Imbibe</h2>\n    <p>From comforting Indonesian classics to shared plates and slow evenings, our kitchen celebrates the rich flavors of Nusantara — warm, familiar, and made for lingering.</p>\n    <a class=\"btn\" href=\"/contact/\">Dine With Us</a>\n  </div>\n</section>\n\n<!-- RENEW -->\n<section class=\"wrap split\" id=\"renew\">\n  <div class=\"media\"><img src=\"/wp-content/themes/natajiwa-child/assets/img/gallery-02.webp\" alt=\"Open-air garden bath\"></div>\n  <div class=\"body reveal d1\">\n    <span class=\"label\">Slow Living</span>\n    <h2>Renew</h2>\n    <p>Draw a bath beneath open air, float in the pool at first light, and let the garden do the rest. At Natajiwa, rest is the itinerary.</p>\n    <a class=\"btn\" href=\"/rooms/\">Unwind With Us</a>\n  </div>\n</section>\n\n<!-- OASIS -->\n<section class=\"oasis\" id=\"oasis\">\n  <div class=\"leaf\" style=\"background-image:url('/wp-content/themes/natajiwa-child/assets/img/gallery-09.webp')\"></div>\n  <div class=\"wrap\">\n    <div class=\"reveal\"><h2>A Bali Sanctuary,<br>Moments from the Coast</h2></div>\n    <div class=\"reveal d1\">\n      <p>Tucked into Kerobokan, Natajiwa keeps you close to the surf of Canggu and the buzz of Seminyak while holding onto stillness — rice-field air, warm teak, and a pool that catches the evening.</p>\n      <a class=\"btn light\" href=\"/gallery/\">Discover More</a>\n    </div>\n  </div>\n</section>\n\n<!-- EXPERIENCES -->\n<section class=\"wrap exp\" id=\"experiences\">\n  <div class=\"reveal\"><span class=\"label\">Around Natajiwa</span><h2>Experiences</h2></div>\n  <div class=\"cards\">\n    <div class=\"card reveal\">\n      <div class=\"ph\"><img src=\"/wp-content/themes/natajiwa-child/assets/img/gallery-04.webp\" alt=\"Canggu\"></div>\n      <h3>Coast &amp; Canggu</h3>\n      <p>Beach clubs, surf, and sunset — ten minutes from the door.</p>\n      <a class=\"btn\" href=\"/gallery/\">Learn More</a>\n    </div>\n    <div class=\"card reveal d1\">\n      <div class=\"ph\"><img src=\"/wp-content/themes/natajiwa-child/assets/img/gallery-05.webp\" alt=\"Seminyak\"></div>\n      <h3>Seminyak Nights</h3>\n      <p>Dining, boutiques, and the island's best evenings, close by.</p>\n      <a class=\"btn\" href=\"/gallery/\">Learn More</a>\n    </div>\n  </div>\n</section>\n\n<!-- CONNECT -->\n<section class=\"wrap connect\" id=\"connect\">\n  <div class=\"head reveal\"><span class=\"label\">@natajiwavillage</span><h2>Connect with us</h2></div>\n  <div class=\"ig\">\n    <a href=\"/gallery/\" class=\"reveal\"><img src=\"/wp-content/themes/natajiwa-child/assets/img/gallery-02.webp\" alt=\"\"></a>\n    <a href=\"/gallery/\" class=\"reveal d1\"><img src=\"/wp-content/themes/natajiwa-child/assets/img/gallery-03.webp\" alt=\"\"></a>\n    <a href=\"/gallery/\" class=\"reveal d2\"><img src=\"/wp-content/themes/natajiwa-child/assets/img/gallery-10.webp\" alt=\"\"></a>\n    <a href=\"/gallery/\" class=\"reveal d3\"><img src=\"/wp-content/themes/natajiwa-child/assets/img/room-living.webp\" alt=\"\"></a>\n  </div>\n</section>\n\n<!-- FOOTER -->"
              }
