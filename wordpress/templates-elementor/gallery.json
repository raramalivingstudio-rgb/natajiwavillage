              "settings": {
                "html": "<section class=\"hero\">\n  <div class=\"hero-frame page\" id=\"hero\">\n    <div class=\"hero-zoom\">\n      <div class=\"hero-drop\">\n        <div class=\"kb\" style=\"background-image:url('/wp-content/themes/natajiwa-child/assets/img/property/garden-lawn.webp')\"></div>\n      </div>\n    </div>\n    <div class=\"hero-copy center\">\n      <span class=\"label\">A Look Inside</span>\n      <h1><span class=\"line\"><i>Gallery</i></span></h1>\n    </div>\n  </div>\n</section>\n\n<!-- INTRO -->\n<section class=\"intro\">\n  <p class=\"reveal\">Teak and garden, water and light — a few frames from life at Natajiwa Village.</p>\n</section>\n\n<!-- GALLERY GRID -->\n<section class=\"wrap\">\n  <div class=\"gallery-grid\">\n    <div class=\"media tall\"><img loading=\"lazy\" decoding=\"async\" src=\"/wp-content/themes/natajiwa-child/assets/img/rooms/garden-villa/bed.webp\" alt=\"Garden Wooden Villa bedroom\"></div>\n    <div class=\"media\"><img loading=\"lazy\" decoding=\"async\" src=\"/wp-content/themes/natajiwa-child/assets/img/property/pool-garden.webp\" alt=\"The pool\"></div>\n    <div class=\"media\"><img loading=\"lazy\" decoding=\"async\" src=\"/wp-content/themes/natajiwa-child/assets/img/rooms/deluxe-villa/bathroom.webp\" alt=\"Stone bathtub\"></div>\n    <div class=\"media\"><img loading=\"lazy\" decoding=\"async\" src=\"/wp-content/themes/natajiwa-child/assets/img/property/garden-lawn.webp\" alt=\"Garden and dining pavilion\"></div>\n    <div class=\"media tall\"><img loading=\"lazy\" decoding=\"async\" src=\"/wp-content/themes/natajiwa-child/assets/img/rooms/garden-villa/bathroom.webp\" alt=\"Open-air bathroom\"></div>\n    <div class=\"media\"><img loading=\"lazy\" decoding=\"async\" src=\"/wp-content/themes/natajiwa-child/assets/img/property/restaurant-hall.webp\" alt=\"Restaurant pavilion\"></div>\n    <div class=\"media\"><img loading=\"lazy\" decoding=\"async\" src=\"/wp-content/themes/natajiwa-child/assets/img/rooms/pool-villa/pool-view.webp\" alt=\"Pool Villa deck\"></div>\n    <div class=\"media\"><img loading=\"lazy\" decoding=\"async\" src=\"/wp-content/themes/natajiwa-child/assets/img/property/villas-twilight.webp\" alt=\"Wooden villas at twilight\"></div>\n    <div class=\"media tall\"><img loading=\"lazy\" decoding=\"async\" src=\"/wp-content/themes/natajiwa-child/assets/img/property/aerial-property.webp\" alt=\"Aerial over the village\"></div>\n    <div class=\"media\"><img loading=\"lazy\" decoding=\"async\" src=\"/wp-content/themes/natajiwa-child/assets/img/rooms/deluxe-villa/terrace.webp\" alt=\"Deluxe Villa terrace\"></div>\n    <div class=\"media\"><img loading=\"lazy\" decoding=\"async\" src=\"/wp-content/themes/natajiwa-child/assets/img/property/pool-aerial.webp\" alt=\"Pool from above\"></div>\n    <div class=\"media\"><img loading=\"lazy\" decoding=\"async\" src=\"/wp-content/themes/natajiwa-child/assets/img/rooms/garden-villa/bedroom-pool.webp\" alt=\"Bedroom opening to pool\"></div>\n  </div>\n</section>\n\n<!-- QUOTE -->\n<section class=\"quote\">\n  <div class=\"reveal\">\n    <span class=\"label\">@natajiwavillage</span>\n    <p>Come find the quiet corners — the ones the photos only hint at.</p>\n  </div>\n</section>\n\n<!-- CTA OASIS -->\n<section class=\"oasis\" id=\"oasis\">\n  <div class=\"leaf\" style=\"background-image:url('/wp-content/themes/natajiwa-child/assets/img/gallery-09.webp')\"></div>\n  <div class=\"wrap\">\n    <div class=\"reveal\"><h2>Your Stay Begins<br>with a Message</h2></div>\n    <div class=\"reveal d1\">\n      <p>Ready to trade the scroll for the real thing? Tell us your dates and we'll take care of the rest.</p>\n      <a class=\"btn light\" href=\"https://beds24.com/book-natajiwa\" target=\"_blank\" rel=\"noopener\">Reserve Your Stay</a>\n    </div>\n  </div>\n</section>\n\n<!-- FOOTER -->"
